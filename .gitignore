# --- Secrets -----------------------------------------------------------------
# .env.example IS committed; real env files never are.
.env
.env.*
!.env.example

# --- Raw run output ----------------------------------------------------------
# Every run writes its evidence bundle here: the structured event log, the
# result, failure screenshots and accessibility-tree snapshots. Text is redacted
# as it is written, but screenshots show whatever was on screen, so raw run
# output is never committed.
#
# /evidence/ IS committed as a deliverable. The scenario scripts write their
# bundles there directly; a discovery run is copied there deliberately, by hand,
# after it has been reviewed.
.runs/

# --- Dependencies & build ----------------------------------------------------
node_modules/
dist/
build/
*.tsbuildinfo

# --- Playwright --------------------------------------------------------------
playwright-report/
test-results/
blob-report/
.playwright/
.cache/

# --- Editor & OS -------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Local tooling -----------------------------------------------------------
.claude/settings.local.json
*.log
npm-debug.log*

# --- Assignment brief --------------------------------------------------------
# interface.ai's take-home document. Kept locally for reference, not published
# to a public repo — it is their material to distribute, not ours.
docs/

# Stray files from shell-quoting accidents on Windows (command fragments that
# got interpreted as redirect targets).
console.log*
src.includes*
