# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Required for discovery only ----------------------------------------------
# The LLM-driven discovery agent needs this. Deterministic replay, the scenario
# scripts, the capability catalog and the test suite do NOT: replay has no model
# in the loop and runs with no key present.
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional -----------------------------------------------------------------
# Model used for discovery. Opus 5 is the default.
ANTHROPIC_MODEL=claude-opus-5

# Thinking depth / token spend for the discovery loop: low|medium|high|xhigh|max
ANTHROPIC_EFFORT=high

# Sign-on password of the local demo application (apps/legacy-demo). Synthetic:
# the demo accepts any operator ID with this password. Hand it to commands with
# --secret-env or --input-env rather than typing it, so it is registered for
# redaction and stays out of shell history.
MERIDIAN_PASSWORD=demo

# Port the local demo application listens on (npm run demo). The committed
# capabilities record http://127.0.0.1:4173/ as their entrypoint; pass
# --entrypoint to replay against a different port.
DEMO_APP_PORT=4173

# Operator console for human-in-the-loop handoff (discover/replay --escalate).
# Handoff works headless: the operator acts through the console, which shows a
# screenshot of the live session. Add --headed to a command to also watch the
# browser window.
OPERATOR_PORT=4174
