# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Required for the discovery run -------------------------------------------
# The LLM-driven discovery agent needs this. Deterministic replay does NOT —
# replay runs with no model in the loop and no key present.
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional -----------------------------------------------------------------
# Model used for discovery. Opus 5 is the default.
ANTHROPIC_MODEL=claude-opus-5

# Thinking depth / token spend for the discovery loop: low|medium|high|xhigh|max
ANTHROPIC_EFFORT=high

# Where the local legacy demo app listens.
DEMO_APP_PORT=4173

# Operator surface for human-in-the-loop escalation.
OPERATOR_PORT=4174

# Run the browser headed (1) or headless (0). Handoff requires headed.
HEADED=1
